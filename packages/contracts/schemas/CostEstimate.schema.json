{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "default": "USD",
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "max_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upper budget bound.",
          "title": "Max Usd"
        },
        "min_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lower budget bound.",
          "title": "Min Usd"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "BudgetAlternative": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "savings_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Savings Usd"
        },
        "tradeoffs": {
          "items": {
            "type": "string"
          },
          "title": "Tradeoffs",
          "type": "array"
        }
      },
      "required": [
        "description"
      ],
      "title": "BudgetAlternative",
      "type": "object"
    },
    "CostLineItem": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "default": "",
          "title": "Category",
          "type": "string"
        },
        "is_estimate": {
          "default": true,
          "title": "Is Estimate",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "line_total_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Total Usd"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "supplier": {
          "default": "",
          "title": "Supplier",
          "type": "string"
        },
        "unit_price_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price Usd"
        }
      },
      "required": [
        "label"
      ],
      "title": "CostLineItem",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alternatives": {
      "items": {
        "$ref": "#/$defs/BudgetAlternative"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "budget_status": {
      "default": "unknown",
      "enum": [
        "under",
        "within",
        "over",
        "unknown"
      ],
      "title": "Budget Status",
      "type": "string"
    },
    "contingency_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contingency Usd"
    },
    "line_items": {
      "items": {
        "$ref": "#/$defs/CostLineItem"
      },
      "title": "Line Items",
      "type": "array"
    },
    "shipping_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shipping Usd"
    },
    "subtotal_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtotal Usd"
    },
    "total_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Usd"
    }
  },
  "title": "CostEstimate",
  "type": "object"
}
