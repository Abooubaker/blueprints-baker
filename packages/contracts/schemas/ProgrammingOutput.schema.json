{
  "$defs": {
    "CodeFile": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "language",
        "content"
      ],
      "title": "CodeFile",
      "type": "object"
    },
    "CodeLanguage": {
      "description": "Programming languages the generated bundle can scaffold.",
      "enum": [
        "python",
        "cpp",
        "c",
        "stm32_assembly",
        "verilog",
        "vhdl",
        "other"
      ],
      "title": "CodeLanguage",
      "type": "string"
    },
    "LanguageBundle": {
      "additionalProperties": false,
      "description": "All files generated for one selected programming language.",
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/CodeFile"
          },
          "title": "Files",
          "type": "array"
        },
        "framework": {
          "default": "",
          "title": "Framework",
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/CodeLanguage"
        },
        "libraries": {
          "items": {
            "type": "string"
          },
          "title": "Libraries",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "status": {
          "default": "scaffold",
          "enum": [
            "complete",
            "scaffold"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "language",
        "display_name"
      ],
      "title": "LanguageBundle",
      "type": "object"
    },
    "TargetPlatform": {
      "enum": [
        "arduino",
        "esp32",
        "raspberry_pi",
        "other",
        "undecided"
      ],
      "title": "TargetPlatform",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundles": {
      "items": {
        "$ref": "#/$defs/LanguageBundle"
      },
      "title": "Bundles",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/CodeFile"
      },
      "title": "Files",
      "type": "array"
    },
    "framework": {
      "default": "",
      "title": "Framework",
      "type": "string"
    },
    "language": {
      "default": "",
      "title": "Language",
      "type": "string"
    },
    "libraries": {
      "items": {
        "type": "string"
      },
      "title": "Libraries",
      "type": "array"
    },
    "pin_assignments": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Pin Assignments",
      "type": "object"
    },
    "platform": {
      "$ref": "#/$defs/TargetPlatform"
    },
    "setup_steps": {
      "items": {
        "type": "string"
      },
      "title": "Setup Steps",
      "type": "array"
    },
    "upload_steps": {
      "items": {
        "type": "string"
      },
      "title": "Upload Steps",
      "type": "array"
    },
    "validation_notes": {
      "items": {
        "type": "string"
      },
      "title": "Validation Notes",
      "type": "array"
    }
  },
  "required": [
    "platform"
  ],
  "title": "ProgrammingOutput",
  "type": "object"
}
