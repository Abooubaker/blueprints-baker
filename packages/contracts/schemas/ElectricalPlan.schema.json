          "type": "string"
        },
        "from_ref": {
          "title": "From Ref",
          "type": "string"
        },
        "kind": {
          "default": "signal",
          "enum": [
            "power",
            "ground",
            "signal",
            "motor",
            "bus"
          ],
          "title": "Kind",
          "type": "string"
        },
        "net": {
          "default": "",
          "title": "Net",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "signal": {
          "default": "",
          "title": "Signal",
          "type": "string"
        },
        "to_pin": {
          "title": "To Pin",
          "type": "string"
        },
        "to_ref": {
          "title": "To Ref",
          "type": "string"
        },
        "voltage_v": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voltage V"
        },
        "wire_color": {
          "default": "",
          "title": "Wire Color",
          "type": "string"
        },
        "wire_gauge_awg": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wire Gauge Awg"
        }
      },
      "required": [
        "from_ref",
        "from_pin",
        "to_ref",
        "to_pin"
      ],
      "title": "ElectricalConnection",
      "type": "object"
    },
    "ElectricalIssue": {
      "additionalProperties": false,
      "description": "A deterministic validation finding shown before power is applied.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
