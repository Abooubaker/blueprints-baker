{
  "$defs": {
    "AgentName": {
      "enum": [
        "robot_planner",
        "component_research",
        "electrical_engineering",
        "programming",
        "mechanical_design",
        "cost_estimation"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "AgentResultStatus": {
      "enum": [
        "succeeded",
        "failed",
        "skipped",
        "not_implemented"
      ],
      "title": "AgentResultStatus",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "completion_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "prompt_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Normalized result every agent must return.",
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentName"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "output": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "agent",
    "status"
  ],
  "title": "AgentResult",
  "type": "object"
}
