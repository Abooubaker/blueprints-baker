{
  "$defs": {
    "BillOfMaterialsItem": {
      "additionalProperties": false,
      "description": "A required component slot, optionally resolved to a concrete candidate.",
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/ComponentCandidate"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "description": "e.g. \"left drive motor\", \"main controller\".",
          "title": "Role",
          "type": "string"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentCandidate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "role",
        "category"
      ],
      "title": "BillOfMaterialsItem",
      "type": "object"
    },
    "ComponentCandidate": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "default": "unknown",
          "title": "Availability",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "cheapest_price_jod": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cheapest Price Jod"
        },
        "cheapest_store": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoreName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compatibility_notes": {
          "items": {
            "type": "string"
          },
          "title": "Compatibility Notes",
          "type": "array"
        },
        "manufacturer": {
          "default": "",
          "title": "Manufacturer",
          "type": "string"
        },
        "model_number": {
          "default": "",
          "title": "Model Number",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "offers": {
          "description": "Store estimates sorted cheapest to most expensive.",
          "items": {
            "$ref": "#/$defs/StoreOffer"
          },
          "title": "Offers",
          "type": "array"
        },
        "price_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Usd"
        },
        "score": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "specs": {
          "additionalProperties": true,
          "title": "Specs",
          "type": "object"
        },
        "supplier": {
          "default": "",
          "title": "Supplier",
          "type": "string"
        },
        "supplier_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supplier Url"
        }
      },
      "required": [
        "name",
        "category"
      ],
      "title": "ComponentCandidate",
      "type": "object"
    },
    "StoreName": {
      "description": "Stores the guided flow can price a part against.",
      "enum": [
        "temu",
        "mikroelectron",
        "waslleh",
        "amazon",
        "aliexpress",
        "ghanimjo"
      ],
      "title": "StoreName",
      "type": "string"
    },
    "StoreOffer": {
      "additionalProperties": false,
      "description": "One store's estimate for a part, in Jordanian dinars.",
      "properties": {
        "availability": {
          "default": "unknown",
          "title": "Availability",
          "type": "string"
        },
        "is_estimate": {
          "default": true,
          "title": "Is Estimate",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "price_jod": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Price Jod"
        },
        "product_url": {
          "default": "",
          "title": "Product Url",
          "type": "string"
        },
        "store": {
          "$ref": "#/$defs/StoreName"
        }
      },
      "required": [
        "store",
        "label",
        "price_jod"
      ],
      "title": "StoreOffer",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bill_of_materials": {
      "items": {
        "$ref": "#/$defs/BillOfMaterialsItem"
      },
      "title": "Bill Of Materials",
      "type": "array"
    },
    "compatibility_notes": {
      "items": {
        "type": "string"
      },
      "title": "Compatibility Notes",
      "type": "array"
    },
    "currency": {
      "default": "JOD",
      "title": "Currency",
      "type": "string"
    },
    "selected_shops": {
      "items": {
        "$ref": "#/$defs/StoreName"
      },
      "title": "Selected Shops",
      "type": "array"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "total_estimated_jod": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Estimated Jod"
    },
    "total_estimated_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Estimated Usd"
    },
    "unresolved_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Requirements",
      "type": "array"
    }
  },
  "title": "ComponentResearchOutput",
  "type": "object"
}
