          },
          "title": "Files",
          "type": "array"
        },
        "framework": {
          "default": "",
          "title": "Framework",
          "type": "string"
        },
        "language": {
          "default": "",
          "title": "Language",
          "type": "string"
        },
        "libraries": {
          "items": {
            "type": "string"
          },
          "title": "Libraries",
          "type": "array"
        },
        "pin_assignments": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Pin Assignments",
          "type": "object"
        },
        "platform": {
          "$ref": "#/$defs/TargetPlatform"
        },
        "setup_steps": {
          "items": {
            "type": "string"
          },
          "title": "Setup Steps",
          "type": "array"
        },
        "upload_steps": {
          "items": {
            "type": "string"
          },
          "title": "Upload Steps",
          "type": "array"
        },
        "validation_notes": {
          "items": {
            "type": "string"
          },
          "title": "Validation Notes",
          "type": "array"
        }
      },
      "required": [
        "platform"
      ],
      "title": "ProgrammingOutput",
      "type": "object"
    },
    "ProjectContext": {
      "additionalProperties": false,
      "description": "Input shared by every agent execution.",
      "properties": {
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "project_name": {
          "title": "Project Name",
          "type": "string"
        },
        "robot_type": {
          "$ref": "#/$defs/RobotType"
        },
        "shared": {
          "$ref": "#/$defs/SharedProjectContext"
        }
      },
      "required": [
        "project_id",
        "project_name",
        "robot_type",
        "description"
      ],
      "title": "ProjectContext",
      "type": "object"
    },
    "RobotSpecificationDraft": {
      "additionalProperties": false,
      "description": "Structured, buildable interpretation of the user's request.",
      "properties": {
        "confidence": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "difficulty": {
          "$ref": "#/$defs/Difficulty",
          "default": "beginner"
        },
        "dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "drive_type": {
          "$ref": "#/$defs/DriveType",
          "default": "none"
        },
        "environment": {
          "default": "indoor",
          "title": "Environment",
          "type": "string"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "payload_capacity_kg": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Capacity Kg"
        },
        "power_source": {
          "default": "",
          "title": "Power Source",
          "type": "string"
        },
        "requirements": {
          "items": {
            "type": "string"
          },
          "title": "Requirements",
          "type": "array"
        },
        "robot_type": {
          "$ref": "#/$defs/RobotType",
          "default": "custom"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Success Criteria",
          "type": "array"
        },
        "summary": {
          "description": "One-paragraph description of the robot.",
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "target_platform": {
          "$ref": "#/$defs/TargetPlatform",
          "default": "undecided"
        },
        "use_case": {
          "default": "",
          "description": "What the robot must do and where.",
          "title": "Use Case",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
