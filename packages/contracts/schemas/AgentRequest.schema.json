        "recommended_supply_ma": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Supply Ma"
        },
        "supply_voltage_v": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supply Voltage V"
        }
      },
      "title": "PowerBudget",
      "type": "object"
    },
    "ProgrammingOutput": {
