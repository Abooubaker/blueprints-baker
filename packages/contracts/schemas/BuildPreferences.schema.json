{
  "$defs": {
    "CodeLanguage": {
      "description": "Programming languages the generated bundle can scaffold.",
      "enum": [
        "python",
        "cpp",
        "c",
        "stm32_assembly",
        "verilog",
        "vhdl",
        "other"
      ],
      "title": "CodeLanguage",
      "type": "string"
    },
    "Difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "PrintMaterial": {
      "description": "Materials carried by the 3D-print price chart.",
      "enum": [
        "PLA",
        "PETG",
        "ABS",
        "Resin",
        "TPU"
      ],
      "title": "PrintMaterial",
      "type": "string"
    },
    "PrintSettings": {
      "additionalProperties": false,
      "description": "User-adjustable 3D print assumptions.\n\n``price_per_gram_jod`` is optional. When set, it replaces the chart rate for\n``material`` so the estimate can match a local supplier or spool price.",
      "properties": {
        "infill_percent": {
          "default": 35,
          "maximum": 100,
          "minimum": 0,
          "title": "Infill Percent",
          "type": "integer"
        },
        "material": {
          "$ref": "#/$defs/PrintMaterial",
          "default": "PLA"
        },
        "price_per_gram_jod": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Per Gram Jod"
        }
      },
      "title": "PrintSettings",
      "type": "object"
    },
    "RobotType": {
      "enum": [
        "line_follower",
        "obstacle_avoider",
        "rover",
        "robot_arm",
        "drone",
        "balancing_bot",
        "custom"
      ],
      "title": "RobotType",
      "type": "string"
    },
    "StoreName": {
      "description": "Stores the guided flow can price a part against.",
      "enum": [
        "temu",
        "mikroelectron",
        "waslleh",
        "amazon",
        "aliexpress",
        "ghanimjo"
      ],
      "title": "StoreName",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Persisted answers from the guided project flow.\n\nThe configuration lives in ``project_configurations.configuration`` as JSON so\nit can evolve without a migration. Every downstream agent reads it through\nrequest parameters.",
  "properties": {
    "budget_max_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Max Usd"
    },
    "confirmed": {
      "default": false,
      "title": "Confirmed",
      "type": "boolean"
    },
    "controller_notes": {
      "default": "",
      "title": "Controller Notes",
      "type": "string"
    },
    "controllers": {
      "items": {
        "type": "string"
      },
      "title": "Controllers",
      "type": "array"
    },
    "custom_pcb": {
      "default": false,
      "title": "Custom Pcb",
      "type": "boolean"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty",
      "default": "beginner"
    },
    "identification_confidence": {
      "default": 0.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Identification Confidence",
      "type": "number"
    },
    "identification_rationale": {
      "default": "",
      "title": "Identification Rationale",
      "type": "string"
    },
    "languages": {
      "items": {
        "$ref": "#/$defs/CodeLanguage"
      },
      "title": "Languages",
      "type": "array"
    },
    "print_settings": {
      "$ref": "#/$defs/PrintSettings"
    },
    "robot_name": {
      "default": "",
      "title": "Robot Name",
      "type": "string"
    },
    "robot_type": {
      "$ref": "#/$defs/RobotType",
      "default": "custom"
    },
    "shops": {
      "items": {
        "$ref": "#/$defs/StoreName"
      },
      "title": "Shops",
      "type": "array"
    }
  },
  "title": "BuildPreferences",
  "type": "object"
}
