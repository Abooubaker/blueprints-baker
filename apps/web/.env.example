# Browser-visible API base URL. The API enables CORS for localhost:3000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Static GitHub Pages demo. Leave both empty for normal development.
# NEVER put provider keys in NEXT_PUBLIC_* variables; they are inlined into the bundle.
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_BASE_PATH=/blueprints-baker
