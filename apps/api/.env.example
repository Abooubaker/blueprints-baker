# ---------------------------------------------------------------------------
# Albayraq API — copy to `.env` and adjust for your machine.
# Never commit `.env`; it is git-ignored.
# ---------------------------------------------------------------------------

# Runtime
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection used by the API and Alembic.
# Local Docker: docker compose up -d db
DATABASE_URL=postgresql+asyncpg://albayraq:albayraq@localhost:5432/albayraq

# AI provider selection. `mock` is deterministic and offline; it does not call
# any external service and exists only to exercise the agent contracts.
AI_PROVIDER=mock
AI_MODEL=placeholder
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=60
